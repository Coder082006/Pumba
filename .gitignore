.env
.env.*
!.env.example

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# tests/test_architecture.py writes these into a module, runs import-linter
# against them and deletes them. An interrupted run leaves one behind, and it
# must never be committed — it is a deliberate contract violation.
_arch_probe.py
