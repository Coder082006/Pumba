; ---------------------------------------------------------------------------
; 3. The domain layer is pure — SRS §8.2 layer 3, §36.2.
;
;   "backend/apps/*/domain/ holds the pure business logic ... it must contain
;    no imports from Django's ORM."
;
; This is the contract that protects the most audit-sensitive code in the
; system: pricing, cancellation policy, itinerary validation and state
; machine guards. Keeping it free of I/O is what makes it testable without a
; database and reviewable without a debugger.
; ---------------------------------------------------------------------------
allow_indirect_imports = True

[importlinter:contract:domain-layer-is-pure]
name = domain layers import no ORM, no I/O and no other layer
type = forbidden
source_modules =
    apps.identity.domain
    apps.location.domain
    apps.notify.domain
    apps.catalogue.domain
    apps.provider.domain
    apps.inventory.domain
    apps.transport.domain
    apps.trip.domain
    apps.booking.domain
    apps.payment.domain
    apps.messaging.domain
    apps.review.domain
    apps.finance.domain
    apps.administration.domain
; apps.common.authz is a domain layer that happens not to sit under a
; domain/ path: SRS §30.3 makes authorisation a control every module applies,
; and §6.4 gives most modules no dependency on `identity`, so the rule table
; and its decision functions live in the shared kernel instead (ADR 0005).
; It is held to the same purity contract, because that is what it is.
    apps.common.authz
; Django is forbidden wholesale, not merely `django.db`. SRS §36.2 requires
; "no imports from Django's ORM", but a domain function that reaches for
; django.core.cache or django.http is no longer pure either, and
; import-linter cannot address subpackages of external packages. Forbidding
; the whole framework is both stricter and simpler to reason about: the
; domain layer is plain Python over value objects.
forbidden_modules =
    django
    rest_framework
    celery
    redis
    requests
    httpx
    config
allow_indirect_imports = False

; ---------------------------------------------------------------------------
; 4. Vendor SDKs live only in adapters — SRS §36.2, principle A3.
;
;   "backend/apps/*/adapters/ is the only place a third-party SDK may be
;    imported."
;
; Enforced negatively: `requests` and `httpx` are the HTTP clients any real
; adapter will reach for, so an outbound call appearing anywhere else is
; caught here. Named SDKs are added to this list as adapters are built.
; ---------------------------------------------------------------------------

[importlinter:contract:no-outbound-http-outside-adapters]
name = outbound HTTP clients appear only in adapters
type = forbidden
source_modules =
    apps.identity.services
    apps.location.services
    apps.notify.services
    apps.catalogue.services
    apps.provider.services
    apps.inventory.services
    apps.transport.services
    apps.trip.services
    apps.booking.services
    apps.payment.services
    apps.messaging.services
    apps.review.services
    apps.finance.services
    apps.administration.services
forbidden_modules =
    requests
    httpx

; ---------------------------------------------------------------------------
; 5. common and ports are leaves.
;
; `common` holds the shared kernel (base model, Money, errors, event bus,
; state machine, settings read port). `ports` holds protocol definitions.
; Neither may depend on a business module, or the shared kernel becomes a
; back door through which any module reaches any other.
; ---------------------------------------------------------------------------

[importlinter:contract:common-is-a-leaf]
name = common depends on no business module
type = forbidden
source_modules =
    apps.common
forbidden_modules =
    apps.identity
    apps.location
    apps.notify
    apps.catalogue
    apps.provider
    apps.inventory
    apps.transport
    apps.trip
    apps.booking
    apps.payment
    apps.messaging
    apps.review
    apps.finance
    apps.administration
    config

[importlinter:contract:ports-is-a-leaf]
name = ports declares protocols and depends on no business module
type = forbidden
source_modules =
    ports
forbidden_modules =
    apps.identity
