# Copy to .env for local development. Never commit .env (SRS §30.9, §35.5).
# Business configuration does NOT belong here — it lives in system_setting
# rows and is changed at runtime by administrators (SRS §35.5, NFR-M07).
# Only infrastructure configuration belongs in this file.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- Database (PostgreSQL 16 + PostGIS 3.4) ---
POSTGRES_DB=pumba
POSTGRES_USER=pumba
POSTGRES_PASSWORD=pumba
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis 7 (cache, locks, rate limiting, Celery broker, Channels layer) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# --- Web clients ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- External ports ---
# No provider is selected yet (SRS Appendix D-1, D-2). Phase 1 ships
# protocol definitions and fakes only; these are placeholders.
ROUTING_ADAPTER=fake
PAYMENT_ADAPTER=fake
PUSH_ADAPTER=fake
EMAIL_ADAPTER=fake
SMS_ADAPTER=fake
STORAGE_ADAPTER=fake
