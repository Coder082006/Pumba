# Copy to .env for local development. Never commit .env (SRS §30.9, §35.5).
# Business configuration does NOT belong here — it lives in system_setting
# rows and is changed at runtime by administrators (SRS §35.5, NFR-M07).
# Only infrastructure configuration belongs in this file.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- Database (PostgreSQL 16 + PostGIS 3.4) ---
POSTGRES_DB=pumba
POSTGRES_USER=pumba
POSTGRES_PASSWORD=pumba
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis 7 (cache, locks, rate limiting, Celery broker, Channels layer) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# --- Web clients ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- External ports ---
# No provider is selected yet (SRS Appendix D-1, D-2). Phase 1 ships
# protocol definitions and fakes only; these are placeholders.
ROUTING_ADAPTER=fake
PUSH_ADAPTER=fake
EMAIL_ADAPTER=fake

# --- Payments (SRS §21, ADR 0027) ---
# `payment` is the one port with no default. Unset, asking for it raises rather
# than falling back — a gateway that reports success without one being
# configured is worse than a gateway that is plainly absent.
#
# Two supported values:
#
#   PAYMENT_ADAPTER=apps.payment.adapters.stripe_gateway.StripeGateway
#   PAYMENT_ADAPTER=ports.fakes.FakePaymentGateway
#
# The second is for working on the flow without a Stripe account. It is named
# explicitly on purpose: reaching a fake gateway should be a line somebody
# wrote, visible in review, never a default anyone inherited.
PAYMENT_ADAPTER=ports.fakes.FakePaymentGateway

# Stripe test-mode keys, from https://dashboard.stripe.com/test/apikeys. The
# webhook secret comes from `stripe listen` (development) or the endpoint you
# create in the dashboard (deployed). §30.9: values belong in `.env`, which is
# gitignored. Never here, and never in an image.
#
# Test mode only for now. A live secret key in this project would be a mistake
# no code here can undo.
STRIPE_SECRET_KEY=your_stripe_test_secret_key_here
STRIPE_WEBHOOK_SECRET=

# The browser's half. Public by design: a publishable key identifies the Stripe
# account and authorises nothing, which is why the card field can live in the
# page while the secret key never leaves the API. Without it the checkout says
# card payment is not configured rather than rendering a form that cannot work.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51UIw6TFTr8zqEBI4aZsq4cDDf0ewHqZIrp6wwJDOllsT1XcqYrrlw4NC1DylB6GErYMRFZId2Qf1Q8EUMZOwy09W00gBdNKXxN

# To send real mail — verification codes, password resets — point this at the
# SMTP adapter and fill in the six variables below:
#
#   EMAIL_ADAPTER=fake
#
# Any SMTP server works: Gmail, your own host, or the SMTP endpoint of
# SendGrid, Mailgun or SES. Leave EMAIL_ADAPTER as `fake` and the rest is
# ignored — which is what CI and a teammate without credentials want.
#
# §30.9: the password belongs in `.env`, which is gitignored. Never here, and
# never in an image.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Pumba <no-reply@localhost>
SMS_ADAPTER=fake
STORAGE_ADAPTER=fake
